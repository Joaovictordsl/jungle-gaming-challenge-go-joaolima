DATABASE_URL=postgres://postgres:postgres_local@localhost:5433/jungle?sslmode=disable
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_MAX_CONNS=10
HTTP_ADDR=127.0.0.1:8080
HTTP_SHUTDOWN_TIMEOUT=5s
# Credenciais de exemplo exclusivas do ambiente local.
# Token pessoal obtido no LocalStack; configure apenas no .env local ou no shell.
# Necessário para iniciar o serviço localstack do Compose.
LOCALSTACK_AUTH_TOKEN=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local
KEYCLOAK_DB_PASSWORD=keycloak_local
KEYCLOAK_INTERNAL_CLIENT_SECRET=jungle_internal_local
KEYCLOAK_PROVIDER_A_CLIENT_SECRET=jungle_provider_a_local
OIDC_ISSUER_URL=http://localhost:8081/realms/jungle
OIDC_AUDIENCE=jungle-api
OIDC_INTERNAL_CLIENT_ID=jungle-internal
OIDC_HTTP_TIMEOUT=3s
OIDC_PROVIDER_CLIENTS='{"jungle-provider-a":"provider-a"}'

# Consumidor SQS. Habilite somente após validar filas e IAM no LocalStack.
# Credenciais separadas são geradas pelo hook em /var/lib/localstack/jungle.
SQS_ENABLED=false
SQS_ENDPOINT=http://127.0.0.1:4566
SQS_REGION=us-east-1
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_PROVIDER_ID=provider-a
SQS_CONSUMER_NAME=wager-transactions-provider-a-v1
SQS_WORKERS=4
SQS_ACCESS_KEY_ID=
SQS_SECRET_ACCESS_KEY=

# Publisher da outbox: identidade IAM exclusiva para a fila de eventos.
OUTBOX_ENABLED=false
OUTBOX_ENDPOINT=http://127.0.0.1:4566
OUTBOX_REGION=us-east-1
OUTBOX_QUEUE_NAME=wallet-events.fifo
OUTBOX_DLQ_NAME=wallet-events-dlq.fifo
OUTBOX_WORKERS=2
OUTBOX_ACCESS_KEY_ID=
OUTBOX_SECRET_ACCESS_KEY=
