{
  "realm": "jungle",
  "enabled": true,
  "displayName": "Jungle Gaming Local",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 300,
  "defaultSignatureAlgorithm": "RS256",
  "roles": {
    "client": {
      "jungle-api": [
        {
          "name": "wallets:read",
          "description": "Consultar carteiras pelo servi\u00e7o interno"
        },
        {
          "name": "wallets:write",
          "description": "Abrir carteiras pelo servi\u00e7o interno"
        },
        {
          "name": "wagering:write",
          "description": "Enviar opera\u00e7\u00f5es do provedor autorizado"
        },
        {
          "name": "wagering:read",
          "description": "Consultar transa\u00e7\u00f5es do provedor autorizado"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "jungle-api",
      "name": "Jungle API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false
    },
    {
      "clientId": "jungle-internal",
      "name": "Servi\u00e7o interno de carteiras",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_INTERNAL_CLIENT_SECRET}",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "jungle-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "jungle-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "jungle-api-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "jungle-api",
            "claim.name": "resource_access.jungle-api.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "jungle-provider-a",
      "name": "Provedor A local",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_PROVIDER_A_CLIENT_SECRET}",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "jungle-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "jungle-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "jungle-api-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "jungle-api",
            "claim.name": "resource_access.jungle-api.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clientScopeMappings": {
    "jungle-api": [
      {
        "client": "jungle-internal",
        "roles": [
          "wallets:read",
          "wallets:write"
        ]
      },
      {
        "client": "jungle-provider-a",
        "roles": [
          "wagering:write",
          "wagering:read"
        ]
      }
    ]
  },
  "users": [
    {
      "username": "service-account-jungle-internal",
      "enabled": true,
      "serviceAccountClientId": "jungle-internal",
      "clientRoles": {
        "jungle-api": [
          "wallets:read",
          "wallets:write"
        ]
      }
    },
    {
      "username": "service-account-jungle-provider-a",
      "enabled": true,
      "serviceAccountClientId": "jungle-provider-a",
      "clientRoles": {
        "jungle-api": [
          "wagering:write",
          "wagering:read"
        ]
      }
    }
  ]
}
