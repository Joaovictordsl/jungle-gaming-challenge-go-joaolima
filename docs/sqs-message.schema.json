{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WagerTransactionRequested",
  "description": "SQS FIFO; JSON UTF-8 de até 16384 bytes. Chaves duplicadas são rejeitadas em todos os objetos. IDs têm até 256 bytes UTF-8 e não podem conter apenas espaços.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageId",
    "type",
    "occurredAt",
    "data"
  ],
  "properties": {
    "messageId": {
      "$ref": "#/$defs/id"
    },
    "type": {
      "const": "WagerTransactionRequested"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "externalTransactionId",
        "idempotencyKey",
        "walletId",
        "playerId",
        "roundId",
        "gameId",
        "kind",
        "money"
      ],
      "properties": {
        "providerId": {
          "$ref": "#/$defs/id"
        },
        "externalTransactionId": {
          "$ref": "#/$defs/id"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/id"
        },
        "walletId": {
          "$ref": "#/$defs/id"
        },
        "playerId": {
          "$ref": "#/$defs/id"
        },
        "roundId": {
          "$ref": "#/$defs/id"
        },
        "gameId": {
          "$ref": "#/$defs/id"
        },
        "referenceExternalTransactionId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "BET",
            "WIN",
            "LOSS",
            "REFUND",
            "ROLLBACK"
          ]
        },
        "money": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "currency"
          ],
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]{2}$",
              "description": "Centavos devem caber em int64; máximo 92233720368547758.07. Sem sinal ou notação exponencial."
            },
            "currency": {
              "enum": [
                "BRL",
                "USD"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "REFUND",
                  "ROLLBACK"
                ]
              }
            }
          },
          "then": {
            "required": [
              "referenceExternalTransactionId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "BET",
                  "LOSS"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "referenceExternalTransactionId"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "LOSS"
              }
            }
          },
          "then": {
            "properties": {
              "money": {
                "properties": {
                  "amount": {
                    "pattern": "^0+\\.00$"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "money": {
                "properties": {
                  "amount": {
                    "not": {
                      "pattern": "^0+\\.00$"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    }
  }
}
